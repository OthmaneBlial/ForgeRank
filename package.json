{
  "name": "forgerank",
  "version": "0.1.1",
  "type": "module",
  "description": "Explainable repository rankings from public GitHub evidence—without REST or GraphQL API credentials.",
  "license": "UNLICENSED",
  "author": "Othmane Blial",
  "homepage": "https://othmaneblial.github.io/ForgeRank/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OthmaneBlial/ForgeRank.git"
  },
  "bugs": {
    "url": "https://github.com/OthmaneBlial/ForgeRank/issues"
  },
  "keywords": [
    "github",
    "analytics",
    "repository-analysis",
    "rankings",
    "developer-tools",
    "local-first",
    "zero-api"
  ],
  "bin": {
    "forgerank": "bin/forgerank.mjs",
    "forgerank-worker": "bin/forgerank-worker.mjs"
  },
  "files": [
    "bin/",
    "data/seeds/",
    "dist/",
    "drizzle/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:prepare": "FORGERANK_SAMPLE_PROFILE=e2e FORGERANK_DATA_DIR=data/e2e-pglite tsx scripts/prepare-sample-data.ts",
    "demo:prepare": "FORGERANK_SAMPLE_PROFILE=demo FORGERANK_DATA_DIR=data/demo-pglite tsx scripts/prepare-sample-data.ts",
    "demo": "pnpm demo:prepare && FORGERANK_DEMO_MODE=1 FORGERANK_DATA_DIR=data/demo-pglite next dev --hostname 127.0.0.1 --port 3001",
    "test:e2e": "pnpm e2e:prepare && playwright test",
    "audit:accessibility": "pnpm e2e:prepare && playwright test e2e/accessibility.spec.ts",
    "audit:dependencies": "pnpm audit --prod",
    "audit:performance": "pnpm e2e:prepare && playwright test --config playwright.performance.config.ts",
    "audit:postgres": "tsx scripts/verify-postgres.ts",
    "serve:production-audit": "tsx scripts/start-production-audit.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/index.ts db migrate",
    "seed": "tsx src/cli/index.ts seed",
    "forge": "tsx src/cli/index.ts",
    "worker": "tsx src/worker/index.ts",
    "package:build": "esbuild src/cli/index.ts src/worker/index.ts --bundle --packages=external --platform=node --format=esm --target=node22 --outbase=src --outdir=dist",
    "prepack": "pnpm package:build",
    "prepublishOnly": "pnpm verify",
    "verify:zero-api": "tsx scripts/verify-zero-api.ts",
    "verify": "pnpm verify:zero-api && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@swc/helpers": "^0.5.23",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.541.0",
    "next": "16.3.1",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "robots-parser": "^3.0.1",
    "tsx": "^4.20.5",
    "undici": "^8.10.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.3.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
