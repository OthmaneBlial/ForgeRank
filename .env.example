# Optional in production. When omitted, ForgeRank uses local embedded PostgreSQL via PGlite.
DATABASE_URL=postgresql://forgerank:forgerank@localhost:5432/forgerank
DATABASE_POOL_SIZE=10

# Used by docker-compose's private PostgreSQL service. Prefer a URL-safe random
# value in deployed environments; the default is only for local Compose use.
FORGERANK_POSTGRES_PASSWORD=forgerank
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact/project URL used in ForgeRank's transparent HTTP user agent.
FORGERANK_CONTACT_URL=https://example.com/forgerank

# Conservative acquisition defaults. These are budgets, never targets to exhaust.
FETCH_CONCURRENCY=2
MIN_REQUEST_INTERVAL_MS=5000
MAX_RETRIES=2
HTTP_CACHE_TTL_SECONDS=21600
HOURLY_CRAWL_BUDGET=60
DAILY_CRAWL_BUDGET=500
GIT_CACHE_MAX_GB=10
REFRESH_SCHEDULE_BATCH_SIZE=25
REFRESH_SCHEDULER_INTERVAL_MS=900000
REFRESH_REQUEST_COOLDOWN_MS=900000
# Set to 1 only behind a trusted proxy that overwrites forwarded client headers.
FORGERANK_TRUST_PROXY=0
FORGERANK_RATE_LIMIT_SALT=replace-with-a-long-random-production-secret
FORGERANK_SCORE_VERSION=repository-v1

# The operator dashboard is disabled by default. This development-only bypass
# is accepted only on exact loopback hosts and never when NODE_ENV=production.
FORGERANK_ENABLE_LOCAL_ADMIN=0

# For production, enable explicit HTTP Basic authentication behind HTTPS.
# Keep both values empty in committed files and inject them from your secret store.
FORGERANK_ENABLE_ADMIN=0
FORGERANK_ADMIN_USERNAME=
FORGERANK_ADMIN_PASSWORD=
